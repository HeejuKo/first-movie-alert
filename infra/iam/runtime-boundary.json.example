{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:000000000000:table/movie-alert-state"
    },
    {
      "Sid": "ReadCheckerHealth",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:000000000000:table/movie-alert-state",
      "Condition": {
        "ForAllValues:StringEquals": {"dynamodb:LeadingKeys": ["health:v1:checker"]},
        "Null": {"dynamodb:LeadingKeys": "false"}
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-northeast-2:000000000000:log-group:/aws/lambda/movie-alert-checker:*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-2:000000000000:function:movie-alert-checker"
    }
  ]
}
